//Для работы с метаданными
Функция ПолучитьМетаданныеОбъекта(Запрос)
    УстановитьПривилегированныйРежим(Истина);
    
    // 1. Инициализируем объект ответа сразу, чтобы не было падений
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    
    // 2. Извлекаем имя объекта из параметров запроса плагина (например: "Документ.РеализацияТоваровУслуг")
    ПолноеИмяОбъекта = Запрос.ПараметрыURL.Получить("object");
    
    Если ПустаяСтрока(ПолноеИмяОбъекта) Тогда
        // Дефолтный обЯъект для тестов, если плагин ничего не передал
        ПолноеИмяОбъекта = "Документ.РеализацияТоваровУслуг"; 
    КонецЕсли;
    
    ЧастиИмени = СтрРазделить(ПолноеИмяОбъекта, ".");
    Если ЧастиИмени.Количество() < 2 Тогда
        Ответ.КодСтатуса = 400;
        Ответ.УстановитьТелоИзСтроки("Неверный формат объекта. Ожидается Тип.Имя (например: Документ.РеализацияТоваровУслуг)", КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
        Возврат Ответ;
    КонецЕсли;
    
    ТипОбъекта = ЧастиИмени[0]; // Документ или Справочник
    ИмяОбъекта = ЧастиИмени[1]; // РеализацияТоваровУслуг
    
    // Защита от опечаток в имени: проверяем существование коллекции метаданных
    Попытка
        ОбъектМетаданных = Метаданные[ТипОбъекта][ИмяОбъекта];
    Исключение
        Ответ.КодСтатуса = 404;
        Ответ.УстановитьТелоИзСтроки("Объект " + ПолноеИмяОбъекта + " не найден в метаданных этой конфигурации 1С!", КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
        Возврат Ответ;
    КонецПопытки;
    
    // 3. Формируем структуру метаданных для сериализации
    Результат = Новый Структура;
    Результат.Вставить("Имя",     ОбъектМетаданных.Имя);
    Результат.Вставить("Синоним", ОбъектМетаданных.Синоним);
    
    // Автоматический сбор ВСЕХ реквизитов шапки объекта
    МассивРеквизитов = Новый Массив;
    Для Каждого Реквизит Из ОбъектМетаданных.Реквизиты Цикл
        СтруктураРеквизита = Новый Структура("Имя, Тип", Реквизит.Имя, Строка(Реквизит.Тип));
        МассивРеквизитов.Добавить(СтруктураРеквизита);
    КонецЦикла;
    Результат.Вставить("Реквизиты", МассивРеквизитов);
    
    // Автоматический сбор ВСЕХ Табличных Частей и их внутренних реквизитов (Без БСП)
    МассивТЧ = Новый Массив;
    Если ТипОбъекта = "Документ" Или ТипОбъекта = "Справочник" Или ТипОбъекта = "Обработка" Тогда
        Для Каждого ТЧ Из ОбъектМетаданных.ТабличныеЧасти Цикл
            СтруктураТЧ = Новый Структура("Имя, Синоним", ТЧ.Имя, ТЧ.Синоним);
            
            МассивРеквизитовТЧ = Новый Массив;
            Для Каждого РеквизитТЧ Из ТЧ.Реквизиты Цикл
                МассивРеквизитовТЧ.Добавить(Новый Структура("Имя, Тип", РеквизитТЧ.Имя, Строка(РеквизитТЧ.Тип)));
            КонецЦикла;
            
            СтруктураТЧ.Вставить("Реквизиты", МассивРеквизитовТЧ);
            МассивТЧ.Добавить(СтруктураТЧ);
        КонецЦикла;
    КонецЕсли;
    Результат.Вставить("ТабличныеЧасти", МассивТЧ);
    
    // 4. Переводим готовую структуру в чистый JSON-текст
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, Результат);
    СтрокаJSON = ЗаписьJSON.Закрыть();
    
    // 5. Записываем JSON в тело ответа и отправляем в Python-плагин
    Ответ.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
    Возврат Ответ;
КонецФункции